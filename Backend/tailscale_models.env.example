# Use these values on any machine that should call the model services running
# on your Tailscale-connected GPU host. Replace the hostname with the Serve node's
# actual MagicDNS name.

MODEL_URL=https://gpu-host.your-tailnet.ts.net:8443
CHAT_SERVICE_URL=https://gpu-host.your-tailnet.ts.net:8444
IMAGE_RETRIEVAL_URL=https://gpu-host.your-tailnet.ts.net:8445

# Frontend direct chat access for the patient chatbot UI.
VITE_CHAT_BASE=https://gpu-host.your-tailnet.ts.net:8444
